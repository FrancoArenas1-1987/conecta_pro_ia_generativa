OUTPUT_ROOT=output/runs
TRACKING_ROOT=output/tracking
CONTEXT_PATH=config/context_conecta_pro_ia.yaml
ASSETS_ROOT=/app/assets
LOG_LEVEL=INFO
DEFAULT_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_EXECUTABLE=C:\Users\franc\AppData\Local\Programs\Ollama\ollama.exe
ENABLE_TTS=true
ENABLE_BACKGROUND_MUSIC=true
BACKGROUND_MUSIC_LEVEL=0.20

# Product quality gates
QUALITY_MIN_SCORE=85
POST_REVIEW_STRICT=true
PUBLISH_MIN_SCORE=90
PUBLISH_REQUIRE_AUDIO_WHEN_TTS=true
MARKETING_MIN_SCORE=88
MARKETING_MAX_ITERATIONS=3
CONTINUITY_MIN_SCORE=85
CONTINUITY_MAX_REGENERATIONS=2
ENABLE_VARIANT_EXPLORATION=true
MAX_VARIANT_CANDIDATES=12

# TTS
TTS_PROVIDER=edge
TTS_STRICT=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_PRIMARY=alloy
OPENAI_TTS_VOICE_SECONDARY=sage
OPENAI_TTS_SPEED=1.0

# Social publishing layer
SOCIAL_PUBLISH_ENABLED=false
AUTO_PUBLISH_ON_GENERATE=false
SOCIAL_CHANNEL=local_dryrun

# YouTube API creds (OAuth)
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=public

# TikTok API creds (OAuth)
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Meta / Instagram Graph API creds
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_USER_ACCESS_TOKEN=
META_USER_TOKEN_EXPIRES_AT=
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_TOKEN_MODE=user_refresh
META_ENV_BACKUPS_TO_KEEP=5
META_GRAPH_VERSION=v21.0

# Metricool optional ingestion
METRICOOL_ENABLED=false
METRICOOL_CSV_PATH=

# Optional OpenAI Images API (premium quality scene visuals)
OPENAI_API_KEY=
OPENAI_SCENE_IMAGES=true
OPENAI_SCENE_IMAGES_STRICT=true
OPENAI_SCENE_MAX_IMAGES=24
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high

# Instagram automatic content engine
INSTAGRAM_CATEGORIES_PATH=config/instagram_publication_categories.yaml
INSTAGRAM_DRAFTS_ROOT=output/runs/instagram/drafts
INSTAGRAM_CATALOG_PATH=output/runs/instagram/catalog/publication_catalog.json
INSTAGRAM_STATE_PATH=output/runs/instagram/state.json
INSTAGRAM_RECENT_MEDIA_LIMIT=30
INSTAGRAM_POST_INTERVAL_MINUTES=240
INSTAGRAM_SHORT_TEXT_MAX_CHARS=90
INSTAGRAM_ENABLE_OPENAI_IMAGES=true
INSTAGRAM_SIMULATE_PUBLISH=true
INSTAGRAM_PLAN_PATH=output/runs/instagram/catalog/publication_plan.json
INSTAGRAM_PLAN_HORIZON_HOURS=24
INSTAGRAM_REQUIRE_AI_IMAGE=true
INSTAGRAM_BRANDING_REQUIRED=true
INSTAGRAM_WHATSAPP_CLIENT_URL=https://api.whatsapp.com/send?phone=56983434503
INSTAGRAM_WHATSAPP_PROVIDER_URL=https://api.whatsapp.com/send?phone=56961903199
INSTAGRAM_CROSSPOST_FACEBOOK=true
INSTAGRAM_PUBLISH_MEDIA_MODE=auto
INSTAGRAM_PUBLISH_QUALITY_GATE_ENABLED=false
INSTAGRAM_PUBLISH_QUALITY_MIN_SCORE=90
INSTAGRAM_PUBLISH_REQUIRE_VIDEO_QC=true
INSTAGRAM_PUBLISH_AUTO_VIDEO_FALLBACK_ENABLED=true
INSTAGRAM_PUBLISH_VIDEO_FAILURE_COOLDOWN_MINUTES=360
INSTAGRAM_PUBLISH_PREFLIGHT_TARGETS_ENABLED=true
INSTAGRAM_PUBLISH_PREFLIGHT_TARGETS_STRICT=false
INSTAGRAM_ANTISPAM_COOLDOWN_MINUTES=2880
INSTAGRAM_OPENAI_MONTHLY_BUDGET_USD=5.0
INSTAGRAM_OPENAI_IMAGE_ESTIMATED_COST_USD=0.25
INSTAGRAM_OPENAI_USE_INTERLEAVING=false

# DB solo lectura para fabrica automatica de imagenes IG.
# En VPS, con conectapro-platform corriendo en el mismo host, usar 127.0.0.1:5432.
# No subir credenciales reales. Configurar en .env productivo del VPS.
CP_DB_HOST=127.0.0.1
CP_DB_PORT=5432
CP_DB_NAME=conectapro
CP_DB_USER=conectapro
CP_DB_PASSWORD=
IG_IMAGE_FACTORY_MAX_ATTEMPTS=1
IG_IMAGE_FACTORY_MIN_PROVIDERS=1
IG_IMAGE_FACTORY_MIN_SUCCESS_INTERVAL_HOURS=24


